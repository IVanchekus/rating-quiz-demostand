# Copy to .env and replace passwords/secret before starting.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourQuizBot
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=bridge_quiz
MYSQL_USER=bridge_quiz
MYSQL_PASSWORD=replace_with_random_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_another_random_password
ADMIN_SECRET=replace_with_at_least_32_random_characters
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
ROOM_DURATION_MINUTES=60
QUESTIONS_PER_GAME=10
QUESTION_TIME_LIMIT_SECONDS=30
MAX_POINTS_PER_QUESTION=100
MIN_CORRECT_POINTS=0
LEADERBOARD_POLL_INTERVAL_SECONDS=15
QUESTION_EXPIRATION_CHECK_SECONDS=5
# Local-only backend development may use an explicit SQLAlchemy URL.
# DATABASE_URL=mysql+pymysql://bridge_quiz:password@127.0.0.1:3306/bridge_quiz?charset=utf8mb4
